{
  "name": "campusshield-workspace",
  "version": "1.0.0",
  "description": "CampusShield - Smart Campus Safety and Emergency Response System",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "seed:clean": "npm --prefix backend run seed:clean",
    "test": "npm --prefix backend test",
    "cap:sync": "npx cap sync android",
    "build:apk": "npx cap sync android && cd android && JAVA_HOME=/home/sumanths/.jdk21 ANDROID_HOME=/home/sumanths/android-sdk ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../CampusShield.apk"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "campus-safety",
    "emergency-response",
    "sos",
    "iot-security",
    "design-thinking"
  ],
  "author": "CampusShield Team - Kongu Engineering College",
  "license": "ISC"
}
