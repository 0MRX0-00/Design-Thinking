{
  "name": "campusshield-backend",
  "version": "1.0.0",
  "description": "Backend API & Real-time engine for CampusShield",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
